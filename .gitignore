# Dependencies
node_modules/

# Electron app build output
app/out/
app/release/
app/release-tmp*/
app/demo-dist/

# Stream Deck plugin build output
# The bundled plugin.js is produced by scripts/build.mjs; the packed
# .streamDeckPlugin by `streamdeck pack`. Both ship as GitHub Release assets.
plugin/com.dmtools.dnd-combat-tracker.sdPlugin/bin/
plugin/com.dmtools.dnd-combat-tracker.streamDeckPlugin
plugin/dist/
plugin/.test/
# Intermediate HTML/bundle for the README deck previews; the PNGs are committed
plugin/.preview/

# Stream Deck writes its runtime logs inside the installed plugin folder
plugin/com.dmtools.dnd-combat-tracker.sdPlugin/logs/

# Packaged deliverables — published as GitHub Release assets, not committed
release/

# Editor / OS cruft
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Logs and local scratch
*.log
npm-debug.log*

# Dev-only CDP capture helpers
app/.shoot-*.mjs
app/.verify-*.mjs
