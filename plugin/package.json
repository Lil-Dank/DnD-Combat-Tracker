{
  "name": "deck-of-many-turns-streamdeck",
  "version": "1.0.0",
  "description": "Stream Deck plugin for the Deck of Many Turns desktop app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build-icons.mjs && node scripts/build-profiles.mjs && node scripts/bundle.mjs",
    "watch": "node scripts/bundle.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pack": "streamdeck pack com.dmtools.dnd-combat-tracker.sdPlugin"
  },
  "devDependencies": {
    "@elgato/cli": "^1.5.0",
    "@elgato/streamdeck": "^1.4.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  }
}
